# Leave empty for same-origin requests through nginx (/api, /ws).
# For local dev with `npm run dev`, keep empty and use vite proxy.
VITE_API_BASE_URL=

# Optional override. Production defaults to /tonconnect-manifest.json on the app domain.
VITE_TONCONNECT_MANIFEST_URL=

# Optional: Telegram initData for local dev outside Telegram (DEV only, not in prod build).
# VITE_DEV_INIT_DATA=
