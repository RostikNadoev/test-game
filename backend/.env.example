PORT=8080
GIN_MODE=debug
APP_ENV=local

# Docker Compose uses host=postgres on the internal network.
DATABASE_DSN=host=postgres user=postgres password=postgres dbname=tg_lobbies port=5432 sslmode=disable TimeZone=UTC

# Same bot token as in root .env / tgbot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# A different bot from TELEGRAM_BOT_TOKEN. It receives and confirms withdrawals.
WITHDRAWAL_BOT_TOKEN=your_separate_withdrawal_bot_token
WITHDRAWAL_ADMIN_CHAT_ID=0
WITHDRAWAL_ADMIN_USER_ID=0
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL_HOURS=168

# false for real Telegram Mini App auth.
ALLOW_DEV_AUTH=false

# Public frontend URL served by nginx (same origin for API).
CORS_ALLOW_ORIGINS=https://tw1ngames.duckdns.org

# Admin panel (required when GIN_MODE=release and ADMIN_ENABLED=true)
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_JWT_SECRET=
ADMIN_ALLOWED_ORIGINS=https://tw1ngames2.duckdns.org
