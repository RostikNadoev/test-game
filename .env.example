# Public URL of the nginx entrypoint (Mini App link for BotFather).
PUBLIC_URL=https://tw1ngames.duckdns.org

# Domains
PRIMARY_DOMAIN=tw1ngames.duckdns.org
ADMIN_DOMAIN=tw1ngames2.duckdns.org

# Reverse proxy host ports
NGINX_PORT=80
NGINX_SSL_PORT=443

# Let's Encrypt (required once on the server: ./scripts/init-letsencrypt.sh)
CERTBOT_EMAIL=you@example.com
DATA_PATH=./certbot

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tg_lobbies

# Backend
GIN_MODE=release
APP_ENV=docker
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL_HOURS=168
ALLOW_DEV_AUTH=false
CORS_ALLOW_ORIGINS=https://tw1ngames.duckdns.org

# Admin panel (required in release mode when ADMIN_ENABLED=true)
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_JWT_SECRET=
ADMIN_ALLOWED_ORIGINS=https://tw1ngames2.duckdns.org
