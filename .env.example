# Public URL of the nginx entrypoint (Mini App link for BotFather).
PUBLIC_URL=http://localhost

# Reverse proxy host port (mini-app)
NGINX_PORT=80

# Admin panel (separate entrypoint)
ADMIN_PORT=8081

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tg_lobbies

# Backend
GIN_MODE=release
APP_ENV=docker
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL_HOURS=168
ALLOW_DEV_AUTH=false
CORS_ALLOW_ORIGINS=http://localhost

# Admin panel (required in release mode when ADMIN_ENABLED=true)
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_JWT_SECRET=
ADMIN_ALLOWED_ORIGINS=http://localhost:8081
